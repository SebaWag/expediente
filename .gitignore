# secrets
.env
*.pem
*.key

# data (regenerate with `expediente fetch-agil`).
# The leading slash matters: without it this rule also swallowed `expediente/data/`,
# which holds the curated acronym table — a source file, not a cache. A clean clone
# then lost every acronym expansion and only the test noticed.
/data/
!examples/*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# os / editor
.DS_Store
.idea/
.vscode/
out/

# OCDS raw sample (7MB, regenerate with the script in docs/OCDS_FINDINGS.md)
benchmarks/raw_ocds_awards.jsonl

# embedding matrix (27MB, regenerate)
benchmarks/name_emb.npy

# Grabación del pitch: los guiones se versionan, los videos no.
# Un mp4 de 40 s pesa 30 MB y el jurado clona el repo.
rec/clips/
rec/entrega/
rec/shots/
*.webm
