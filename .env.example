# Mercado Público — free ticket, requested by form at api.mercadopublico.cl
# v1 (purchase orders) takes the ticket as a query param.
# v2 (compra ágil) takes the ticket as a HEADER.
MP_TICKET=replace-with-your-ticket

# Meta Model API — https://dev.meta.ai
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1

# Fireworks AI — https://fireworks.ai (OpenAI-compatible)
# Used by the extraction layer. The key never reaches a run report.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=

# Tuned extractor (optional). Leave empty and the serverless backend answers.
# Set it to the deployment id once a LoRA adapter is deployed.
EXPEDIENTE_EXTRACT_DEPLOYMENT=
